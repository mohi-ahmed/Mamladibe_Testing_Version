# Development only. Omit in production so /api stays on the frontend origin.
VITE_API_BASE_URL=http://127.0.0.1:3001
VITE_TURNSTILE_SITE_KEY=your-public-turnstile-site-key
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Server-only production variable. Do not prefix with VITE_.
# The frontend server proxies same-origin /api requests to this backend origin.
BACKEND_ORIGIN=https://api.example.com
