{
  "name": "mamladibe-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Contract-first public API for Mamladibe",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings=0",
    "format": "prettier --write .",
    "db:indexes": "tsx src/scripts/sync-indexes.ts",
    "admin:bootstrap": "tsx src/scripts/bootstrap-admin.ts",
    "db:seed:map-test": "tsx src/scripts/seed-map-test-incidents.ts",
    "db:cleanup:map-test": "tsx src/scripts/cleanup-map-test-incidents.ts",
    "db:cleanup:acceptance-test": "tsx src/scripts/cleanup-acceptance-test-interactions.ts",
    "test:acceptance:incident-rate": "tsx src/scripts/verify-incident-rate-limit.ts",
    "test:acceptance:admin": "tsx src/scripts/verify-admin-acceptance.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@node-rs/argon2": "^2.2.2",
    "@upstash/redis": "^1.35.6",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "mongoose": "^8.19.1",
    "otplib": "^13.6.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^9.39.1",
    "prettier": "^3.7.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  }
}
